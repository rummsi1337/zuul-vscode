{
  "name": "zuul-vscode",
  "displayName": "Zuul CI",
  "description": "Zuul CI integration for VS Code",
  "publisher": "zuul-vscode-dev",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.zuul.yaml",
    "workspaceContains:zuul.yaml",
    "workspaceContains:zuul.d/**",
    "workspaceContains:.zuul.d/**",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "zuul.setGhePat",
        "title": "Set GitHub Enterprise PAT",
        "category": "Zuul"
      },
      {
        "command": "zuul.clearGhePat",
        "title": "Clear GitHub Enterprise PAT",
        "category": "Zuul"
      },
      {
        "command": "zuul.refresh",
        "title": "Refresh",
        "category": "Zuul",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "zuul.refresh",
          "when": "view == zuul.gateReadiness",
          "group": "navigation"
        },
        {
          "command": "zuul.refresh",
          "when": "view == zuul.dependencies",
          "group": "navigation"
        },
        {
          "command": "zuul.refresh",
          "when": "view == zuul.builds",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zuul-explorer",
          "title": "Zuul",
          "icon": "resources/icons/zuul.svg"
        }
      ]
    },
    "views": {
      "zuul-explorer": [
        {
          "id": "zuul.gateReadiness",
          "name": "Gate Readiness"
        },
        {
          "id": "zuul.dependencies",
          "name": "Dependencies"
        },
        {
          "id": "zuul.builds",
          "name": "Builds"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "zuul.gateReadiness",
        "contents": "No pull request found for the current branch."
      },
      {
        "view": "zuul.builds",
        "contents": "No Zuul builds for this pull request yet."
      }
    ],
    "configuration": {
      "title": "Zuul",
      "properties": {
        "zuul.url": {
          "type": "string",
          "default": "",
          "markdownDescription": "Base URL of Zuul Web, e.g. `https://zuul.example.com`."
        },
        "zuul.tenant": {
          "type": "string",
          "default": "",
          "markdownDescription": "Zuul tenant name. Auto-detected if empty."
        },
        "zuul.ghe.host": {
          "type": "string",
          "default": "",
          "markdownDescription": "GitHub Enterprise hostname. Auto-detected from git remote if empty."
        },
        "zuul.auth.method": {
          "type": "string",
          "enum": [
            "auto",
            "oauth",
            "gh-cli",
            "pat"
          ],
          "default": "pat",
          "markdownDescription": "Authentication method for GitHub Enterprise (`auto`, `oauth`, `gh-cli`, or `pat`)."
        },
        "zuul.ghe.oauthClientId": {
          "type": "string",
          "default": "",
          "markdownDescription": "OAuth App client ID for GitHub Enterprise Device Flow."
        },
        "zuul.triggerComments": {
          "type": "array",
          "default": [
            {
              "label": "Recheck",
              "comment": "recheck",
              "icon": "refresh"
            }
          ],
          "markdownDescription": "Preset trigger comments offered when posting a comment on a pull request.",
          "items": {
            "type": "object",
            "required": [
              "label",
              "comment"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "description": "Display label shown in the QuickPick."
              },
              "comment": {
                "type": "string",
                "description": "Comment body posted to the pull request."
              },
              "icon": {
                "type": "string",
                "description": "Optional VS Code codicon name."
              }
            }
          }
        },
        "zuul.pinnedArtifacts": {
          "type": "array",
          "default": [
            "job-output.txt"
          ],
          "markdownDescription": "Glob patterns of build log files pinned at the top of each build.",
          "items": {
            "type": "string"
          }
        },
        "zuul.gate.requiredApprovals": {
          "type": "number",
          "default": 1,
          "markdownDescription": "Fallback number of required approvals when not auto-detected from GitHub."
        },
        "zuul.gate.requiredStatusChecks": {
          "type": "object",
          "default": {},
          "markdownDescription": "Additional required status check contexts keyed by `*` or `org/repo`.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "zuul.gate.requiredLabels": {
          "type": "array",
          "default": [],
          "markdownDescription": "Labels that must be present on a pull request for gate readiness.",
          "items": {
            "type": "string"
          }
        },
        "zuul.gate.blockingLabels": {
          "type": "array",
          "default": [
            "do-not-merge",
            "wip"
          ],
          "markdownDescription": "Labels that block a pull request from entering the gate.",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@types/vscode": "~1.100.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
