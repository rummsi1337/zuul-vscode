{
  "name": "zuul-vscode",
  "displayName": "Zuul CI",
  "description": "Zuul CI integration for VS Code",
  "publisher": "zuul-vscode-dev",
  "version": "0.0.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rummsi1337/zuul-vscode.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.101.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.zuul.yaml",
    "workspaceContains:zuul.yaml",
    "workspaceContains:zuul.d/**",
    "workspaceContains:.zuul.d/**",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "zuul.setTenantToken",
        "title": "Set Zuul Tenant Token",
        "category": "Zuul"
      },
      {
        "command": "zuul.clearTenantToken",
        "title": "Clear Zuul Tenant Token",
        "category": "Zuul"
      },
      {
        "command": "zuul.setGhePat",
        "title": "Set GitHub Enterprise PAT",
        "category": "Zuul"
      },
      {
        "command": "zuul.clearGhePat",
        "title": "Clear GitHub Enterprise PAT",
        "category": "Zuul"
      },
      {
        "command": "zuul.refresh",
        "title": "Refresh",
        "category": "Zuul",
        "icon": "$(refresh)"
      },
      {
        "command": "zuul.postTrigger",
        "title": "Post Trigger Comment",
        "category": "Zuul",
        "icon": "$(comment)"
      },
      {
        "command": "zuul.postCustomTrigger",
        "title": "Post Custom Trigger Comment...",
        "category": "Zuul",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "zuul.addDependsOn",
        "title": "Add Depends-On...",
        "category": "Zuul",
        "icon": "$(add)"
      },
      {
        "command": "zuul.removeDependsOn",
        "title": "Remove Depends-On",
        "category": "Zuul",
        "icon": "$(trash)"
      },
      {
        "command": "zuul.syncViaRecheck",
        "title": "Sync via Recheck",
        "category": "Zuul",
        "icon": "$(sync)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "zuul.postTrigger",
          "when": "zuul.hasPr"
        },
        {
          "command": "zuul.postCustomTrigger",
          "when": "zuul.hasPr"
        },
        {
          "command": "zuul.addDependsOn",
          "when": "zuul.hasPr"
        },
        {
          "command": "zuul.removeDependsOn",
          "when": "zuul.hasPr"
        },
        {
          "command": "zuul.syncViaRecheck",
          "when": "zuul.hasPr"
        }
      ],
      "view/title": [
        {
          "command": "zuul.refresh",
          "when": "view == zuul.gateReadiness",
          "group": "navigation"
        },
        {
          "command": "zuul.postTrigger",
          "when": "view == zuul.gateReadiness && zuul.hasPr",
          "group": "navigation"
        },
        {
          "command": "zuul.refresh",
          "when": "view == zuul.dependencies",
          "group": "navigation"
        },
        {
          "command": "zuul.addDependsOn",
          "when": "view == zuul.dependencies && zuul.hasPr",
          "group": "navigation"
        },
        {
          "command": "zuul.refresh",
          "when": "view == zuul.builds",
          "group": "navigation"
        },
        {
          "command": "zuul.postTrigger",
          "when": "view == zuul.builds && zuul.hasPr",
          "group": "navigation"
        },
        {
          "command": "zuul.postCustomTrigger",
          "when": "view == zuul.builds && zuul.hasPr",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "zuul.removeDependsOn",
          "when": "view == zuul.dependencies && viewItem == zuulUpstreamDep",
          "group": "inline"
        },
        {
          "command": "zuul.syncViaRecheck",
          "when": "view == zuul.dependencies && viewItem == zuulOutOfSync",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zuul-explorer",
          "title": "Zuul",
          "icon": "resources/icons/zuul.svg"
        }
      ]
    },
    "views": {
      "zuul-explorer": [
        {
          "id": "zuul.gateReadiness",
          "name": "Gate Readiness"
        },
        {
          "id": "zuul.dependencies",
          "name": "Dependencies"
        },
        {
          "id": "zuul.builds",
          "name": "Builds"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "zuul.gateReadiness",
        "when": "workbenchState == 'empty'",
        "contents": "No folder is open in this window.\n[Open Folder](command:vscode.openFolder)"
      },
      {
        "view": "zuul.gateReadiness",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'no-repo'",
        "contents": "No GitHub or GitHub Enterprise git remote found in this folder.\n[Open Another Folder](command:vscode.openFolder)"
      },
      {
        "view": "zuul.gateReadiness",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'no-zuul-url'",
        "contents": "Set `zuul.url` in settings to connect to Zuul CI.\n[Configure Zuul URL](command:workbench.action.openSettings?%5B%22zuul.url%22%5D)"
      },
      {
        "view": "zuul.gateReadiness",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'no-tenant'",
        "contents": "Could not resolve a Zuul tenant for this repository.\n[Configure Zuul Settings](command:workbench.action.openSettings?%5B%22zuul%22%5D)"
      },
      {
        "view": "zuul.gateReadiness",
        "when": "workbenchState != 'empty' && (!zuul.contextProblem || zuul.contextProblem == 'loading')",
        "contents": "Loading Zuul context..."
      },
      {
        "view": "zuul.gateReadiness",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'none' && zuul.authChecked && !zuul.signedIn",
        "contents": "No GitHub token available, so the pull request could not be loaded.\n[Set GitHub Enterprise PAT](command:zuul.setGhePat)\nSigned in with `gh`? [Refresh](command:zuul.refresh)"
      },
      {
        "view": "zuul.gateReadiness",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'none' && (!zuul.authChecked || zuul.signedIn) && !zuul.hasPr && zuul.pollState == 'no-pr'",
        "contents": "No pull request found for the current branch."
      },
      {
        "view": "zuul.gateReadiness",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'none' && (!zuul.authChecked || zuul.signedIn) && zuul.pollState == 'failed'",
        "contents": "Could not load data from GitHub. [Retry](command:zuul.refresh)"
      },
      {
        "view": "zuul.gateReadiness",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'none' && (!zuul.authChecked || zuul.signedIn) && zuul.pollState == 'auth'",
        "contents": "Could not load data from GitHub. [Retry](command:zuul.refresh)"
      },
      {
        "view": "zuul.gateReadiness",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'none' && (!zuul.authChecked || zuul.signedIn) && zuul.pollState == 'rate-limited'",
        "contents": "Could not load data from GitHub. [Retry](command:zuul.refresh)"
      },
      {
        "view": "zuul.gateReadiness",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'none' && (!zuul.authChecked || zuul.signedIn) && zuul.pollState == 'retrying'",
        "contents": "Could not load data from GitHub, retrying. [Retry now](command:zuul.refresh)"
      },
      {
        "view": "zuul.dependencies",
        "when": "workbenchState == 'empty'",
        "contents": "No folder is open in this window.\n[Open Folder](command:vscode.openFolder)"
      },
      {
        "view": "zuul.dependencies",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'no-repo'",
        "contents": "No GitHub or GitHub Enterprise git remote found in this folder.\n[Open Another Folder](command:vscode.openFolder)"
      },
      {
        "view": "zuul.dependencies",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'no-zuul-url'",
        "contents": "Set `zuul.url` in settings to connect to Zuul CI.\n[Configure Zuul URL](command:workbench.action.openSettings?%5B%22zuul.url%22%5D)"
      },
      {
        "view": "zuul.dependencies",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'no-tenant'",
        "contents": "Could not resolve a Zuul tenant for this repository.\n[Configure Zuul Settings](command:workbench.action.openSettings?%5B%22zuul%22%5D)"
      },
      {
        "view": "zuul.dependencies",
        "when": "workbenchState != 'empty' && (!zuul.contextProblem || zuul.contextProblem == 'loading')",
        "contents": "Loading Zuul context..."
      },
      {
        "view": "zuul.dependencies",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'none' && zuul.authChecked && !zuul.signedIn",
        "contents": "No GitHub token available, so the pull request could not be loaded.\n[Set GitHub Enterprise PAT](command:zuul.setGhePat)\nSigned in with `gh`? [Refresh](command:zuul.refresh)"
      },
      {
        "view": "zuul.dependencies",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'none' && (!zuul.authChecked || zuul.signedIn) && !zuul.hasPr && zuul.pollState == 'no-pr'",
        "contents": "No pull request found for the current branch."
      },
      {
        "view": "zuul.dependencies",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'none' && (!zuul.authChecked || zuul.signedIn) && zuul.pollState == 'failed'",
        "contents": "Could not load data from GitHub. [Retry](command:zuul.refresh)"
      },
      {
        "view": "zuul.dependencies",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'none' && (!zuul.authChecked || zuul.signedIn) && zuul.pollState == 'auth'",
        "contents": "Could not load data from GitHub. [Retry](command:zuul.refresh)"
      },
      {
        "view": "zuul.dependencies",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'none' && (!zuul.authChecked || zuul.signedIn) && zuul.pollState == 'rate-limited'",
        "contents": "Could not load data from GitHub. [Retry](command:zuul.refresh)"
      },
      {
        "view": "zuul.dependencies",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'none' && (!zuul.authChecked || zuul.signedIn) && zuul.pollState == 'retrying'",
        "contents": "Could not load data from GitHub, retrying. [Retry now](command:zuul.refresh)"
      },
      {
        "view": "zuul.builds",
        "when": "workbenchState == 'empty'",
        "contents": "No folder is open in this window.\n[Open Folder](command:vscode.openFolder)"
      },
      {
        "view": "zuul.builds",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'no-repo'",
        "contents": "No GitHub or GitHub Enterprise git remote found in this folder.\n[Open Another Folder](command:vscode.openFolder)"
      },
      {
        "view": "zuul.builds",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'no-zuul-url'",
        "contents": "Set `zuul.url` in settings to connect to Zuul CI.\n[Configure Zuul URL](command:workbench.action.openSettings?%5B%22zuul.url%22%5D)"
      },
      {
        "view": "zuul.builds",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'no-tenant'",
        "contents": "Could not resolve a Zuul tenant for this repository.\n[Configure Zuul Settings](command:workbench.action.openSettings?%5B%22zuul%22%5D)"
      },
      {
        "view": "zuul.builds",
        "when": "workbenchState != 'empty' && (!zuul.contextProblem || zuul.contextProblem == 'loading')",
        "contents": "Loading Zuul context..."
      },
      {
        "view": "zuul.builds",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'none' && zuul.authChecked && !zuul.signedIn",
        "contents": "No GitHub token available, so the pull request could not be loaded.\n[Set GitHub Enterprise PAT](command:zuul.setGhePat)\nSigned in with `gh`? [Refresh](command:zuul.refresh)"
      },
      {
        "view": "zuul.builds",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'none' && (!zuul.authChecked || zuul.signedIn) && !zuul.hasPr && zuul.pollState == 'no-pr'",
        "contents": "No pull request found for the current branch."
      },
      {
        "view": "zuul.builds",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'none' && (!zuul.authChecked || zuul.signedIn) && zuul.pollState == 'failed'",
        "contents": "Could not load data from GitHub. [Retry](command:zuul.refresh)"
      },
      {
        "view": "zuul.builds",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'none' && (!zuul.authChecked || zuul.signedIn) && zuul.pollState == 'auth'",
        "contents": "Could not load data from GitHub. [Retry](command:zuul.refresh)"
      },
      {
        "view": "zuul.builds",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'none' && (!zuul.authChecked || zuul.signedIn) && zuul.pollState == 'rate-limited'",
        "contents": "Could not load data from GitHub. [Retry](command:zuul.refresh)"
      },
      {
        "view": "zuul.builds",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'none' && (!zuul.authChecked || zuul.signedIn) && zuul.pollState == 'retrying'",
        "contents": "Could not load data from GitHub, retrying. [Retry now](command:zuul.refresh)"
      },
      {
        "view": "zuul.builds",
        "when": "workbenchState != 'empty' && zuul.contextProblem == 'none' && (!zuul.authChecked || zuul.signedIn) && zuul.hasPr && (!zuul.zuulProblem || zuul.zuulProblem == 'none')",
        "contents": "No Zuul builds for this pull request yet."
      }
    ],
    "configuration": {
      "title": "Zuul",
      "properties": {
        "zuul.url": {
          "type": "string",
          "default": "",
          "markdownDescription": "Base URL of Zuul Web, including any path prefix, e.g. `https://zuul.example.com` or `https://example.com/zuul`.",
          "scope": "machine"
        },
        "zuul.pollIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 3600,
          "markdownDescription": "Seconds between checks while a build is running. When nothing is running, the extension checks 5 times less often. Lower values use more API requests."
        },
        "zuul.tenant": {
          "type": "string",
          "default": "",
          "markdownDescription": "Zuul tenant name. Auto-detected if empty."
        },
        "zuul.tokens": {
          "type": "object",
          "default": {},
          "markdownDescription": "Per-tenant paths to Zuul read-only token files, keyed by tenant name (or `*` for default). To store a raw token securely, use the **Set Zuul Tenant Token** command. E.g. `{\"ddad\": \"~/.zuul/ddad.token\", \"swh\": \"~/.zuul/swh.token\"}`.",
          "scope": "machine",
          "additionalProperties": {
            "type": "string"
          }
        },
        "zuul.tokenFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute or `~/` path to a file containing a Zuul read-only token, or a JSON object mapping tenant to token. E.g. `~/.zuul/token`.",
          "scope": "machine"
        },
        "zuul.ghe.host": {
          "type": "string",
          "default": "",
          "markdownDescription": "GitHub Enterprise hostname. Auto-detected from git remote if empty."
        },
        "zuul.auth.method": {
          "type": "string",
          "enum": [
            "auto",
            "gh-cli",
            "pat"
          ],
          "markdownEnumDescriptions": [
            "Try a stored personal access token first, then the GitHub CLI (`gh`).",
            "Use the token from the GitHub CLI (`gh auth token`).",
            "Use a personal access token stored with **Set GitHub Enterprise PAT**."
          ],
          "default": "auto",
          "markdownDescription": "Authentication method for GitHub Enterprise. `auto` tries `pat`, then `gh-cli`. OAuth sign-in is not available yet."
        },
        "zuul.ghe.oauthClientId": {
          "type": "string",
          "default": "",
          "markdownDescription": "Not used yet. OAuth App client ID for GitHub Enterprise Device Flow, reserved for a later release."
        },
        "zuul.triggerComments": {
          "type": "array",
          "default": [
            {
              "label": "Recheck",
              "comment": "recheck",
              "icon": "refresh"
            }
          ],
          "markdownDescription": "Preset trigger comments offered when posting a comment on a pull request.",
          "items": {
            "type": "object",
            "required": [
              "label",
              "comment"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "description": "Display label shown in the QuickPick."
              },
              "comment": {
                "type": "string",
                "description": "Comment body posted to the pull request."
              },
              "icon": {
                "type": "string",
                "description": "Optional VS Code codicon name."
              }
            }
          }
        },
        "zuul.pinnedArtifacts": {
          "type": "array",
          "default": [
            "job-output.txt"
          ],
          "markdownDescription": "Glob patterns of build log files pinned at the top of each build.",
          "items": {
            "type": "string"
          }
        },
        "zuul.gate.requiredApprovals": {
          "type": "number",
          "default": 1,
          "markdownDescription": "Fallback number of required approvals when not auto-detected from GitHub. Mirror the approval requirements of your Zuul gate pipeline: Zuul's `require:` rules can't be read through its API."
        },
        "zuul.gate.requiredStatusChecks": {
          "type": "object",
          "default": {},
          "markdownDescription": "Additional required status check contexts keyed by `*` or `org/repo`. `{tenant}` is replaced with the Zuul tenant.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "zuul.gate.requiredLabels": {
          "type": "array",
          "default": [],
          "markdownDescription": "Labels that must be present on a pull request for gate readiness. Mirror the label requirements of your Zuul gate pipeline: Zuul's `require:` rules can't be read through its API.",
          "items": {
            "type": "string"
          }
        },
        "zuul.gate.blockingLabels": {
          "type": "array",
          "default": [
            "do-not-merge",
            "wip"
          ],
          "markdownDescription": "Labels that block a pull request from entering the gate.",
          "items": {
            "type": "string"
          }
        },
        "zuul.gate.gateStatusChecks": {
          "type": "array",
          "default": [
            "{tenant}/gate"
          ],
          "markdownDescription": "Status checks that only report once a pull request enters Zuul's gate. `{tenant}` is replaced with the Zuul tenant.",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@types/vscode": "~1.101.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
